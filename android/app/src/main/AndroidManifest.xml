<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 跑分应用不需要危险权限；results.json 写应用专属目录（ResultsStore），不申请存储权限。 -->
    <!-- Vulkan / GLES 均 optional：CapabilityGate 运行时选择；无 Vulkan 时走 ES 3.1。 -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <uses-feature android:glEsVersion="0x00030001" android:required="false" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Mangekyo"
        android:supportsRtl="true"
        android:extractNativeLibs="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation">
            <!-- 上面这些变化由界面自己处理，不重建 Activity：旋转、分屏拖动、折叠屏展开和合上
                 （smallestScreenSize、screenLayout，内外屏密度不同时还有 density）、接上键盘或鼠标。
                 重建会销毁预览画面，正在运行的测试就丢了。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
