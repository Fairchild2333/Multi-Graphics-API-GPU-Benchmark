# ---- CMake / native engine builds ----
/build/
/build-*/
/out/*
!/out/test-results/
/bin/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/compile_commands.json
/Makefile
/CMakeUserPresets.json

# ---- Android / Gradle generated state ----
/android/.gradle/
/android/.kotlin/
/android/build/
/android/**/build/
/android/**/.cxx/
/android/local.properties
/android/app/src/main/assets/shaders/.configure.lock

# HarmonyOS (DevEco Studio / hvigor)
/ohos/.hvigor/
/ohos/.idea/
/ohos/build/
/ohos/**/build/
/ohos/**/.cxx/
/ohos/**/oh_modules/
/ohos/local.properties
/ohos/**/oh-package-lock.json5
/ohos/oh-package-lock.json5

# ---- WinUI / MSBuild GUI outputs (any arch + intermediates) ----
/gui/x64/
/gui/x86/
/gui/Win32/
/gui/ARM64/
/gui/arm64/
/gui/ARM64EC/
/gui/arm64ec/
/gui/obj/
/gui/bin/
/gui/packages/
/gui/.vs/
/gui/Generated Files/
/gui/*.winmd
/gui/*.user
/gui/*.suo
/gui/*.aps
/gui/*.VC.db
/gui/*.VC.VC.opendb
/gui/*.vcxproj.user

# Visual Studio / MSBuild junk anywhere
.vs/
*.vcxproj.user
*.sln.docstates
*.suo
*.user
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb

# Compiler / linker intermediates
*.obj
*.o
*.pch
*.pdb
*.idb
*.ilk
*.iobj
*.ipdb
*.exp
*.map
*.tlog
*.recipe
*.lastbuildstate
*.log
*.res
*.sbr
*.bsc
*.pgc
*.pgd
*.exe
*.dll
*.so
*.dylib
*.lib
!third_party/**/*.lib

# Shader SPIR-V build outputs (sources stay tracked)
*.spv

# Cross-compiled ARM64 Vulkan import library (gen-vulkan-arm64-lib.ps1)
/vulkan-1.def
/vulkan-1-arm64.*

# Editor / agent local state
.vscode/
.idea/
.claude/
.cursor/
.agents/

# RenderDoc captures (large binaries; keep curated JSON traces)
/rdoc_captures/*.rdc
/rdoc_captures/*.png

# Keep results tracked
# /results/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Accidental console dumps
stdout.txt
stderr.txt

# Copies of shaders/*_gl.* that the mobile builds put beside the SPIR-V
android/app/src/main/assets/shaders/*_gl.*
android/app/src/main/assets/shaders/*_es2.*
ohos/entry/src/main/resources/rawfile/shaders/*_gl.*
ohos/entry/src/main/resources/rawfile/shaders/*_es2.*
macos-gui/theme_check2
macos-gui/theme_check2.swift
scripts/__pycache__/

# ---- Small benchmark evidence is versioned, including native run logs ----
# Keep existing out/test-results links valid without adding build products.
/out/test-results/**/*
!/out/test-results/**/
!/out/test-results/**/*.json
!/out/test-results/**/*.jsonl
!/out/test-results/**/*.ndjson
!/out/test-results/**/*.csv
!/out/test-results/**/*.tsv
!/out/test-results/**/*.log
!/out/test-results/**/*.txt
!/out/test-results/**/*.md
!/out/test-results/**/*.png
!/out/test-results/**/*.jpg
!/out/test-results/**/*.jpeg
!/out/test-results/**/*.svg
!/out/test-results/**/*.pdf
!/out/test-results/**/*.html
!/out/test-results/**/*.htm
!/out/test-results/**/*.xml
!/out/test-results/**/*.plist
!/out/test-results/**/*.patch
!/out/test-results/**/*.py
!/out/test-results/**/*.swift
!/out/test-results/**/*.sh
!/out/test-results/**/*.ps1

# Large diagnostic bundles and copied dependencies remain local. Export their
# small summaries, curve data and screenshots beside them for version control.
/out/test-results/**/*.xcresult/
/out/test-results/**/*.trace/
/out/test-results/**/*.gputrace/
/out/test-results/**/*.tracetemplate/
/out/test-results/**/*.app/
/out/test-results/**/*.dSYM/
/out/test-results/**/*.framework/
/out/test-results/**/*.xcframework/
/out/test-results/**/plot-deps/
/out/test-results/**/site-packages/
/out/test-results/**/__pycache__/
/out/test-results/**/.venv/
/out/test-results/**/venv/
/out/test-results/**/node_modules/
/out/test-results/**/build/
/out/test-results/**/CMakeFiles/

# The default CLI history is small and should be backed up too.
/results/*
!/results/*.json
!/results/*.jsonl
!/results/*.csv
!/results/*.tsv
!/results/*.log
!/results/*.txt
!/results/*.md
