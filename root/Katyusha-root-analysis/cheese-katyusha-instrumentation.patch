+/* katyusha discriminator: same submission machinery (SET_MODE + SDS at IB4 +
+ * kgsl_gpu_command_payload) but WITHOUT CP_SMMU_TABLE_UPDATE — only a benign
+ * CP_MEM_WRITE into our own kgsl-mapped output buffer. Survival + correct
+ * value proves the submission layer healthy and pins the async death on the
+ * SMMU update (TTBR miss) instead of opcode incompatibility. */
+static int cheese_mintest(int fd, int ctx_id, uint32_t* payload_buf,
+                          uint64_t payload_gpuaddr, uint64_t output_gpuaddr,
+                          uint32_t* output_buf) {
+    uint32_t* drawstate_buf = payload_buf + 0x100;
+    uint64_t drawstate_gpuaddr = payload_gpuaddr + 0x100*sizeof(uint32_t);
+    uint32_t* drawstate_cmds = drawstate_buf;
+    drawstate_cmds += cp_wait_for_me(drawstate_cmds);
+    drawstate_cmds += cp_wait_for_idle(drawstate_cmds);
+    *drawstate_cmds++ = cp_type7_packet(CP_MEM_WRITE, 2);
+    drawstate_cmds += cp_gpuaddr(drawstate_cmds, output_gpuaddr);
+    *drawstate_cmds++ = 0x13371337;
+
+    uint32_t* payload_cmds = payload_buf;
+    if (getenv("CHEESE_MINTERST2")) {
+        /* inline in IB0: no SET_MODE, no SDS — pure ring-buffer execution */
+        payload_cmds = payload_buf;
+        *payload_cmds++ = cp_type7_packet(CP_MEM_WRITE, 2);
+        payload_cmds += cp_gpuaddr(payload_cmds, output_gpuaddr);
+        *payload_cmds++ = 0x13371337;
+        payload_cmds += cp_wait_for_me(payload_cmds);
+        payload_cmds += cp_wait_for_idle(payload_cmds);
+        uint32_t cmd_size2 = (payload_cmds - payload_buf) * sizeof(uint32_t);
+        fprintf(stderr, "mintest2 submit: IB0-inline benign write\n"); fflush(stderr);
+        sync_cache_to_gpu((void*)payload_buf, ((void*)payload_buf) + 0x1000);
+        int err2 = kgsl_gpu_command_payload(fd, ctx_id, 0, 0, 1, 0, payload_gpuaddr, cmd_size2);
+        if (err2) {
+            fprintf(stderr, "mintest2 submit failed: %s\n", strerror(err2)); fflush(stderr);
+            return 1;
+        }
+        fprintf(stderr, "mintest2 submitted, polling...\n"); fflush(stderr);
+        for (int i = 0; i < 30; i++) {
+            usleep(200000);
+            sync_cache_from_gpu(output_buf, ((void*)output_buf) + 0x1000);
+            if (output_buf[0] == 0x13371337) {
+                fprintf(stderr, "MINTERST2 PASS: IB0 execution HEALTHY (output=%x)\n", output_buf[0]); fflush(stderr);
+                return 0;
+            }
+        }
+        fprintf(stderr, "mintest2: no execution (output=%x)\n", output_buf[0]); fflush(stderr);
+        return 1;
+    }
+    *payload_cmds++ = cp_type7_packet(CP_SET_MODE, 1);
+    *payload_cmds++ = 1;
+    *payload_cmds++ = cp_type7_packet(CP_SET_DRAW_STATE, 3);
+    *payload_cmds++ = (drawstate_cmds - drawstate_buf) | ((DRAW_STATE_MODE_BINNING | DRAW_STATE_MODE_GMEM | DRAW_STATE_MODE_BYPASS) << 20);
+    payload_cmds += cp_gpuaddr(payload_cmds, drawstate_gpuaddr);
+    uint32_t cmd_size = (payload_cmds - payload_buf) * sizeof(uint32_t);
+    fprintf(stderr, "mintest submit: benign MEM_WRITE only\n"); fflush(stderr);
+    sync_cache_to_gpu((void*)payload_buf, ((void*)payload_buf) + 0x1000);
+    int err = kgsl_gpu_command_payload(fd, ctx_id, 0, 0, 1, 0, payload_gpuaddr, cmd_size);
+    if (err) {
+        fprintf(stderr, "mintest submit failed: %s\n", strerror(err)); fflush(stderr);
+        return 1;
+    }
+    fprintf(stderr, "mintest submitted, waiting for GPU...\n"); fflush(stderr);
+    for (int i = 0; i < 30; i++) {
+        usleep(200000);
+        /* output_buf is kgsl-REGISTERED (small page) — syncing it is the
+         * normal, safe path; without it a non-io-coherent read misses the
+         * GPU's DRAM write. */
+        sync_cache_from_gpu(output_buf, ((void*)output_buf) + 0x1000);
+        if (output_buf[0] == 0x13371337) {
+            fprintf(stderr, "MINTERST PASS: output=%x after %d polls — submission layer HEALTHY\n",
+                    output_buf[0], i); fflush(stderr);
+            return 0;
+        }
+    }
+    fprintf(stderr, "mintest: marker never arrived (output=%x) — stream didn't execute\n",
+            output_buf[0]); fflush(stderr);
+    return 1;
+}
