      <AdditionalLibraryDirectories>$(GpuBuildDir)\$(Configuration);$(GpuBuildDir);$(VULKAN_SDK)\Lib;$(VcpkgLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
