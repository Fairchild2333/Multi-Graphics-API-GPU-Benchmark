  </ItemDefinitionGroup>

  <!-- Copy glfw3.dll (vcpkg, dynamic) next to the GUI. CopyGpuBenchmarkWorker
       also stages the CLI worker + shader assets beside the GUI so adjacent
       gpu_benchmark.exe can resolve HLSL/SPIR-V/OpenGL sources from its exe dir. -->
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>copy /Y "$(VcpkgBin)\glfw3.dll" "$(OutDir)" &gt;nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Midl Include="MainWindow.idl" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h" />
    <ClInclude Include="MainWindow.h" />
    <ClInclude Include="MainWindow.xaml.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp" />
    <ClCompile Include="MainWindow.xaml.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <ClCompile Include="XamlTypeInfo.cpp" />
  </ItemGroup>
  <ItemGroup>
