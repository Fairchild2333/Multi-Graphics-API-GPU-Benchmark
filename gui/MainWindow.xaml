<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="gpu_bench_gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mangekyo — Cross-API CPU &amp; GPU Benchmark Suite">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootShell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (draggable region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image x:Name="TitleBarIcon" Width="20" Height="20"/>
                <TextBlock Text="Mangekyo" VerticalAlignment="Center"
                           FontSize="12" Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="200"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavRun" Content="GPU" Tag="0" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <!-- SpeedHigh: Fluent performance gauge — closer to GPU/benchmark
                             than the old TV/monitor glyph, and distinct from CPU's chip. -->
                        <FontIcon Glyph="&#xEC4A;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCpu" Content="CPU" Tag="5">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistory" Content="History" Tag="1">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCharts" Content="Charts" Tag="2">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="3">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Content="About" Tag="4">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="RootGrid" Padding="0,4,0,0">

                <!-- ===================== Run page ===================== -->
                <!-- Transparent background: empty page areas must hit-test so
                     clicks there can dismiss focus-driven popups. PointerPressed
                     is wired in code with handledEventsToo (controls swallow it). -->
                <Grid x:Name="RunPage" Visibility="Visible" Margin="28,12,28,0"
                      IsTabStop="True" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="RunTitle" Text="GPU Benchmark" Style="{StaticResource TitleTextBlockStyle}"/>

                            <!-- Options card -->
                            <Border Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="16">
                                    <ComboBox x:Name="PresetBox" Header="Preset" HorizontalAlignment="Stretch"
                                              SelectedIndex="1" SelectionChanged="OnPresetChanged">
                                        <!-- Quick / Flights / Particles / Headless shortcuts hidden:
                                             same flows are covered by Custom + Advanced options. -->
                                        <ComboBoxItem x:Name="PresetQuick" Visibility="Collapsed">Quick run (best API / GPU, Medium)</ComboBoxItem>
                                        <ComboBoxItem x:Name="PresetCustom">Custom run (choose API / GPU / workload)</ComboBoxItem>
                                        <ComboBoxItem x:Name="PresetFullOne">Full analysis — selected workload / one GPU (selected APIs + RenderDoc + charts)</ComboBoxItem>
                                        <ComboBoxItem x:Name="PresetFullAll">Full analysis — selected workload / all GPUs × selected APIs (+ RenderDoc + charts)</ComboBoxItem>
                                        <ComboBoxItem x:Name="PresetFlights" Visibility="Collapsed">Flights test — one GPU (selected APIs, custom flights)</ComboBoxItem>
                                        <ComboBoxItem x:Name="PresetParticles" Visibility="Collapsed">Particle test — one GPU (selected APIs, custom particles)</ComboBoxItem>
                                        <ComboBoxItem x:Name="PresetHeadless" Visibility="Collapsed">Headless compute — one GPU (selected APIs, pure compute)</ComboBoxItem>
                                    </ComboBox>
                                    <!-- Same ComboBox chrome for GPU / API / Workload. API uses MaxDropDownHeight=0
                                         + Tapped flyout so the native list never paints (avoids stuck popup). -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="GpuHeader" Grid.Row="0" Grid.Column="0"
                                                   Text="GPU" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="GpuBox" Grid.Row="1" Grid.Column="0"
                                                  MinWidth="160" Height="32"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnGpuSelectionChanged"/>

                                        <TextBlock x:Name="ApiPickerHeader" Grid.Row="0" Grid.Column="1"
                                                   Text="Graphics API" Margin="0,0,0,4" Opacity="0.55"
                                                   Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                        <ComboBox x:Name="ApiPickerBox" Grid.Row="1" Grid.Column="1"
                                                  Height="32"
                                                  IsEnabled="False" Opacity="0.55"
                                                  Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                  MaxDropDownHeight="0"
                                                  HorizontalAlignment="Stretch"
                                                  DropDownOpened="OnApiPickerDropDownOpened"
                                                  Tapped="OnApiPickerTapped"
                                                  AutomationProperties.Name="Graphics API">
                                            <ComboBoxItem x:Name="ApiPickerSummaryItem" Content="Detecting…"
                                                          Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                            <FlyoutBase.AttachedFlyout>
                                                <Flyout x:Name="ApiPickerFlyout" Placement="Bottom">
                                                    <StackPanel Width="300" Spacing="10">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button x:Name="SelectAllRunApis" Content="All"/>
                                                            <Button x:Name="ClearAllRunApis" Content="None"/>
                                                        </StackPanel>
                                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                            <StackPanel Spacing="12">
                                                                <StackPanel x:Name="SupportedApisGroup" Spacing="4"
                                                                            AutomationProperties.Name="Supported APIs">
                                                                    <TextBlock x:Name="SupportedApisLabel" Text="Supported"
                                                                               FontWeight="SemiBold"
                                                                               AutomationProperties.HeadingLevel="Level2"/>
                                                                    <StackPanel x:Name="SupportedApisPanel" Spacing="2"/>
                                                                </StackPanel>
                                                                <StackPanel x:Name="UnsupportedApisGroup" Spacing="4"
                                                                            AutomationProperties.Name="Unsupported APIs">
                                                                    <TextBlock x:Name="UnsupportedApisLabel" Text="Not reported as supported"
                                                                               FontWeight="SemiBold"
                                                                               AutomationProperties.HeadingLevel="Level2"/>
                                                                    <StackPanel x:Name="UnsupportedApisPanel" Spacing="2"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                        <TextBlock x:Name="UnsupportedApisHint"
                                                                   Text="Unsupported selections remain available and will be reported by the CLI."
                                                                   TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </FlyoutBase.AttachedFlyout>
                                        </ComboBox>

                                        <TextBlock x:Name="WorkloadHeader" Grid.Row="0" Grid.Column="2"
                                                   Text="Workload" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="WorkloadBox" Grid.Row="1" Grid.Column="2"
                                                  MinWidth="120" Height="32" SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnWorkloadChanged">
                                            <ComboBoxItem x:Name="WorkloadStream" Tag="stream">Particle — Memory Throughput</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadGpuBurn" Tag="gpu_burn">Mangekyo Kaleidoscope — GPU Burn</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadCinematicLiquid" Tag="cinematic_liquid">Fluid — Interactive Pool</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadGpuStress" Tag="gpu_stress">GraphicsBurn v1 / Component (Advanced)</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadNBody" Tag="nbody">N-Body — Advanced Compute</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadSynthPeak" Tag="synthpeak">SynthPeak — Advanced Synthetic</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadStress" Tag="stress">Legacy Stress v1 — Fragment ALU/SFU</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadRender3D" Tag="render3d">Legacy 3D Prototype — Billboards</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadVolumetric" Tag="volumetric">Volumetric — Experimental Raymarch</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadFluid" Tag="fluid">Other / Legacy 2D Fluid</ComboBoxItem>
                                            <ComboBoxItem x:Name="WorkloadCinematicLiquidV1" Tag="cinematic_liquid_v1">Other / Legacy Cinematic Liquid v1 — Dam Break</ComboBoxItem>
                                        </ComboBox>

                                        <!-- Precision is SynthPeak-only; hide the whole column by default. -->
                                        <StackPanel x:Name="PrecisionColumn" Grid.Row="0" Grid.Column="3"
                                                    Grid.RowSpan="2" Spacing="0" Visibility="Collapsed">
                                            <TextBlock x:Name="PrecisionHeader" Text="Precision" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="PrecisionBox" MinWidth="100" Height="32"
                                                      SelectedIndex="0" IsEnabled="False"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem x:Name="PrecisionFp32" Tag="fp32">fp32 — standard float</ComboBoxItem>
                                                <ComboBoxItem x:Name="PrecisionFp16" Tag="fp16">fp16 — half precision</ComboBoxItem>
                                                <ComboBoxItem x:Name="PrecisionFp64" Tag="fp64">fp64 — double precision</ComboBoxItem>
                                                <ComboBoxItem x:Name="PrecisionInt32" Tag="int32">int32 — integer ops</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <InfoBar x:Name="WorkloadInfo" IsOpen="True" IsClosable="False"
                                             Severity="Informational"/>
                                    <!-- Responsive: Extra stretches/shrinks so it never clips at min width. -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DurationUnitBox" Grid.Column="0" Header="Duration" MinWidth="140"
                                                  SelectedIndex="0" SelectionChanged="OnDurationUnitChanged">
                                            <ComboBoxItem x:Name="DurationSeconds" Tag="seconds">Seconds</ComboBoxItem>
                                            <ComboBoxItem x:Name="DurationMinutes" Tag="minutes">Minutes</ComboBoxItem>
                                            <ComboBoxItem x:Name="DurationHours" Tag="hours">Hours</ComboBoxItem>
                                            <ComboBoxItem x:Name="DurationFrames" Tag="frames">Frames</ComboBoxItem>
                                            <ComboBoxItem x:Name="DurationUnlimited" Tag="unlimited">Until Cancel</ComboBoxItem>
                                        </ComboBox>
                                        <NumberBox x:Name="DurationValueBox" Grid.Column="1" Header="Value" Value="15" Width="150"
                                                   Minimum="1" Maximum="360000" SmallChange="1"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValidationMode="InvalidInputOverwritten"
                                                   ValueChanged="OnDurationValueChanged"/>
                                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                                            <ComboBox x:Name="ParticlePresetBox" Header="Particles" Width="220"
                                                      SelectedIndex="1" SelectionChanged="OnParticlePresetChanged">
                                                <ComboBoxItem x:Name="ParticlesLight" Tag="65536">Light — 65K</ComboBoxItem>
                                                <ComboBoxItem x:Name="ParticlesMedium" Tag="1048576">Medium — 1M</ComboBoxItem>
                                                <ComboBoxItem x:Name="ParticlesHeavy" Tag="4194304">Heavy — 4M</ComboBoxItem>
                                                <ComboBoxItem x:Name="ParticlesExtreme" Tag="16777216">Extreme — 16M</ComboBoxItem>
                                                <ComboBoxItem x:Name="ParticlesCustom" Tag="custom">Custom…</ComboBoxItem>
                                            </ComboBox>
                                            <TextBox x:Name="CustomParticleBox" Header="Custom particles" Width="220"
                                                     PlaceholderText="multiple of 256" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel x:Name="BurnStepPanel" Grid.Column="2" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                                            <ComboBox x:Name="BurnStepPresetBox" Header="GPU Burn steps" Width="220"
                                                      SelectedIndex="0" SelectionChanged="OnBurnStepPresetChanged">
                                                <ComboBoxItem x:Name="BurnStepsLight" Tag="16">Light — 16</ComboBoxItem>
                                                <ComboBoxItem x:Name="BurnStepsMedium" Tag="64">Medium — 64</ComboBoxItem>
                                                <ComboBoxItem x:Name="BurnStepsHeavy" Tag="256">Heavy — 256</ComboBoxItem>
                                                <ComboBoxItem x:Name="BurnStepsCustom" Tag="custom">Custom…</ComboBoxItem>
                                            </ComboBox>
                                            <TextBox x:Name="BurnCustomStepBox" Header="Custom steps" Width="220"
                                                     PlaceholderText="16–2048" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <!-- Fixed width: only a short optional number; do not span the row. -->
                                        <TextBox x:Name="ExtraBox" Grid.Column="2" Header="Extra" PlaceholderText="optional"
                                                 Visibility="Collapsed" Width="260"
                                                 HorizontalAlignment="Left"/>
                                        <TextBox x:Name="FluidJacobiBox" Grid.Column="3" Header="Jacobi iterations"
                                                 PlaceholderText="optional; default 30"
                                                 Visibility="Collapsed" Width="220"
                                                 HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced card -->
                            <Border Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="AdvancedLabel" Text="Advanced" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox x:Name="HeadlessBox" Content="Headless" MinWidth="0"/>
                                            <FontIcon x:Name="HeadlessInfo" Glyph="&#xE946;" FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="VsyncBox" Content="V-Sync" MinWidth="0"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox x:Name="HostMemBox" Content="System memory" MinWidth="0"/>
                                            <FontIcon x:Name="HostMemInfo" Glyph="&#xE946;" FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowLegacyBox" Content="Show legacy &amp; advanced tests"
                                                  MinWidth="0" Checked="OnShowLegacyChecked" Unchecked="OnShowLegacyChecked"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="MultiGpuLabel" Text="Multi-GPU"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="MultiGpuBox" Width="112" Height="32"
                                                      SelectedIndex="0"
                                                      SelectionChanged="OnMultiGpuChanged">
                                                <ComboBoxItem x:Name="MultiGpuOff" Tag="off">Off</ComboBoxItem>
                                                <ComboBoxItem x:Name="MultiGpuAfr" Tag="afr">AFR</ComboBoxItem>
                                                <ComboBoxItem x:Name="MultiGpuSfr" Tag="sfr">SFR</ComboBoxItem>
                                            </ComboBox>
                                            <FontIcon x:Name="MultiGpuInfo" Glyph="&#xE946;" FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox x:Name="RenderDocBox" Content="RenderDoc" MinWidth="0"
                                                      IsChecked="True"
                                                      Checked="OnRenderDocChecked" Unchecked="OnRenderDocChecked"/>
                                            <FontIcon x:Name="RenderDocInfo" Glyph="&#xE946;" FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox x:Name="CaptureBox" Content="Capture at" MinWidth="0"
                                                      IsChecked="True"
                                                      Checked="OnCaptureChecked" Unchecked="OnCaptureChecked"/>
                                            <!-- Compact spin buttons expand into a vertical flyout while
                                                 the number field is focused. -->
                                            <NumberBox x:Name="CaptureValueBox" Width="160" Minimum="1"
                                                       Maximum="15" Value="5" SmallChange="1"
                                                       SpinButtonPlacementMode="Compact"
                                                       ValidationMode="InvalidInputOverwritten"
                                                       ValueChanged="OnCaptureValueChanged"/>
                                            <TextBlock x:Name="CaptureUnitLabel" Text="s"
                                                       VerticalAlignment="Center"/>
                                            <FontIcon x:Name="CaptureInfo" Glyph="&#xE946;" FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Run progress: worker index + elapsed-time estimate
                                 (GPU workers report no live progress protocol). -->
                            <Border Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GpuStageText" Text="Ready" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GpuProgressText" Grid.Column="1" Text="0%" Opacity="0.72"/>
                                    </Grid>
                                    <ProgressBar x:Name="GpuProgressBar" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Result score -->
                            <Border Padding="16,12,16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="GpuSummaryTitle" Text="Summary" FontWeight="SemiBold"
                                               Margin="0,0,0,2"/>
                                    <TextBlock x:Name="ResultText" FontSize="20" FontWeight="SemiBold" Text="—"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               OpticalMarginAlignment="TrimSideBearings"/>
                                    <TextBlock x:Name="ResultHint" Visibility="Collapsed"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button x:Name="GpuOpenResultsButton" Content="Open results folder"
                                                Click="OnOpenResultsFolder"/>
                                        <Button x:Name="GpuOpenCapturesButton" Content="Open RenderDoc captures"
                                                Click="OnOpenCapturesFolder"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CLI follows page content (not pinned above the action bar). -->
                            <Border x:Name="GpuCliHost" Padding="12" MinWidth="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    SizeChanged="OnGpuCliHostSizeChanged">
                                <Expander x:Name="GpuOutputExpander" Header="Raw CLI output"
                                          IsExpanded="False"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          MinWidth="0">
                                    <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
                                             Height="200" FontFamily="Consolas" TextWrapping="NoWrap"
                                             HorizontalAlignment="Stretch" MinWidth="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollMode="Enabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action bar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"
                                Margin="0,10,0,12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="GpuStatusLight" Width="10" Height="10"
                                     Fill="#6CCB5F" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Status" Text="Ready" VerticalAlignment="Center"
                                       Margin="0,-1,0,1"/>
                        </StackPanel>
                        <!-- Kept for code that toggles IsActive; traffic light is the visible status. -->
                        <ProgressRing x:Name="Busy" IsActive="False" Width="22" Height="22"
                                      Visibility="Collapsed"/>
                        <Button x:Name="GpuCancelButton" Content="Cancel" Click="OnGpuCancel"
                                IsEnabled="False"/>
                        <Button x:Name="RunButton" Content="Run GPU Benchmark" Click="OnRun"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ===================== CPU page ===================== -->
                <!-- Same shell as GPU: scrollable body (incl. CLI) + pinned action bar. -->
                <Grid x:Name="CpuPage" Visibility="Collapsed" Margin="28,12,28,0"
                      IsTabStop="True" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="CpuTitle" Text="CPU Benchmark"
                                           Style="{StaticResource TitleTextBlockStyle}"/>
                                <TextBlock x:Name="CpuNameText" Text="CPU" Opacity="0.72"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="14">
                                    <InfoBar x:Name="CpuInfo" IsOpen="True" IsClosable="False"
                                             Severity="Informational"
                                             Message="Measures CPU compute throughput with dense math loops on logical processors (single-core and multi-core)."/>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" MinWidth="0"/>
                                            <ColumnDefinition Width="1.3*" MinWidth="0"/>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CpuModeBox" Grid.Column="0" Header="Test mode"
                                                  SelectedIndex="2" HorizontalAlignment="Stretch">
                                            <ComboBoxItem x:Name="CpuModePerCore" Tag="per-core">Each logical processor</ComboBoxItem>
                                            <ComboBoxItem x:Name="CpuModeMulti" Tag="multi">All cores together</ComboBoxItem>
                                            <ComboBoxItem x:Name="CpuModeAll" Tag="all">Per-core + all-core</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox x:Name="CpuDurationPresetBox" Grid.Column="1" Header="Duration preset"
                                                  SelectedIndex="0" HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnCpuDurationPresetChanged">
                                            <ComboBoxItem x:Name="CpuDurationQuick" Tag="1">Quick (1 s)</ComboBoxItem>
                                            <ComboBoxItem x:Name="CpuDurationFormal" Tag="15">Formal (15 s)</ComboBoxItem>
                                        </ComboBox>
                                        <!-- Compact spin buttons match the GPU duration controls.
                                             Warm-up keeps one decimal — the formal contract is 15.0 s + 0.2 s. -->
                                        <NumberBox x:Name="CpuTimeBox" Grid.Column="2" Header="Seconds per test"
                                                   Value="1" Minimum="1" Maximum="3600" SmallChange="1"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValidationMode="InvalidInputOverwritten"
                                                   ValueChanged="OnCpuTimeChanged"/>
                                        <NumberBox x:Name="CpuWarmupBox" Grid.Column="3" Header="Warm-up seconds"
                                                   Value="0.2" Minimum="0" Maximum="60" SmallChange="0.1"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValidationMode="InvalidInputOverwritten"
                                                   ValueChanged="OnCpuTimeChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="CpuDurationHint" Opacity="0.72" TextWrapping="Wrap"
                                               Text="Per-core duration is applied separately to every logical processor; the formal preset can take a long time."/>
                                </StackPanel>
                            </Border>

                            <Border Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CpuCurrentCoreText" Text="Ready" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CpuProgressText" Grid.Column="1" Text="0%" Opacity="0.72"/>
                                    </Grid>
                                    <ProgressBar x:Name="CpuProgressBar" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Fixed height so ListView can scroll inside the page ScrollViewer. -->
                            <Grid ColumnSpacing="12" Height="260"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="0"/>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="16" MinWidth="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid MinWidth="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="CpuPerCoreTitle" Text="Per-logical-processor results"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>
                                        <ListView x:Name="CpuCoreResultsList" Grid.Row="1" SelectionMode="None"
                                                  MinWidth="0"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CpuSummaryCard" Grid.Column="1" Padding="16" MinWidth="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <StackPanel Spacing="14" MinWidth="0">
                                        <TextBlock x:Name="CpuSummaryTitle" Text="Summary" FontWeight="SemiBold"/>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="CpuAverageLabel" Text="Per-core average" Opacity="0.72"/>
                                            <TextBlock x:Name="CpuAverageResult" Text="&#x2014;" FontSize="20" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="CpuMultiLabel" Text="All-core result" Opacity="0.72"/>
                                            <TextBlock x:Name="CpuMultiResult" Text="&#x2014;" FontSize="20" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- CLI follows page content (not pinned above the action bar). -->
                            <Border x:Name="CpuCliHost" Padding="12" MinWidth="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    SizeChanged="OnCpuCliHostSizeChanged">
                                <Expander x:Name="CpuOutputExpander" Header="Raw CLI output"
                                          IsExpanded="False"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          MinWidth="0">
                                    <TextBox x:Name="CpuOutputBox" IsReadOnly="True" AcceptsReturn="True"
                                             Height="200" FontFamily="Consolas" TextWrapping="NoWrap"
                                             HorizontalAlignment="Stretch" MinWidth="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollMode="Enabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"
                                Margin="0,10,0,12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="CpuStatusLight" Width="10" Height="10"
                                     Fill="#6CCB5F" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuStatusText" Text="Ready" VerticalAlignment="Center"
                                       Margin="0,-1,0,1"/>
                        </StackPanel>
                        <Button x:Name="CpuCancelButton" Content="Cancel" Click="OnCpuCancel" IsEnabled="False"/>
                        <Button x:Name="CpuRunButton" Content="Run CPU Benchmark" Click="OnCpuRun"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ===================== History page ===================== -->
                <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="28,12,28,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                        <TextBlock x:Name="HistoryTitle" Text="History" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshHistory" VerticalAlignment="Bottom"/>
                        <Button x:Name="DeleteButton" Content="Delete selected" Click="OnDeleteSelected"
                                VerticalAlignment="Bottom" Background="#C42B1C" Foreground="White"/>
                        <Button x:Name="OpenResultsFolderButton" Content="Open results folder"
                                Click="OnOpenResultsFolder" VerticalAlignment="Bottom"/>
                        <Button x:Name="OpenCapturesFolderButton" Content="Open captures folder"
                                Click="OnOpenCapturesFolder" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <!-- GPU/CPU tabs + optional GPU-only toggles, vertically centered together. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16"
                                Margin="0,0,0,10" VerticalAlignment="Center">
                        <SelectorBar x:Name="HistoryCategoryTabs"
                                     VerticalAlignment="Center"
                                     SelectionChanged="OnHistoryCategoryChanged">
                            <SelectorBarItem x:Name="HistoryGpuTab" Text="GPU" IsSelected="True"/>
                            <SelectorBarItem x:Name="HistoryCpuTab" Text="CPU"/>
                        </SelectorBar>
                        <StackPanel Orientation="Horizontal" Spacing="16"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="HistoryLegacyBox"
                                      Content="Show legacy tests"
                                      VerticalAlignment="Center"
                                      Checked="OnHistoryLegacyChecked"
                                      Unchecked="OnHistoryLegacyChecked"/>
                            <CheckBox x:Name="HistoryHeadlessBox"
                                      Content="Show headless"
                                      VerticalAlignment="Center"
                                      Checked="OnHistoryLegacyChecked"
                                      Unchecked="OnHistoryLegacyChecked"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Horizontal StackPanel: collapsed filters leave no ColumnSpacing gap. -->
                    <StackPanel x:Name="HistoryFilterRow" Grid.Row="2" Orientation="Horizontal"
                                Spacing="12" Margin="0,0,0,8" VerticalAlignment="Bottom">
                        <StackPanel x:Name="ApiFilterColumn" Spacing="4" VerticalAlignment="Bottom"
                                    MinWidth="140">
                            <TextBlock x:Name="ApiFilterLabel" Text="Graphics API" Margin="1,0,0,0"/>
                            <DropDownButton x:Name="ApiFilterButton" Content="Graphics API" Height="32"
                                            MinWidth="140"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center">
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="ApiFilterFlyout" Placement="Bottom">
                                        <StackPanel Width="260" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="SelectAllApis" Content="All"/>
                                                <Button x:Name="ClearAllApis" Content="None"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="ApiFilterPanel" Spacing="2"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <StackPanel x:Name="WorkloadFilterColumn" Spacing="4" VerticalAlignment="Bottom"
                                    MinWidth="180">
                            <TextBlock x:Name="WorkloadFilterLabel" Text="Workload" Margin="1,0,0,0"/>
                            <DropDownButton x:Name="WorkloadFilterButton" Content="All workloads" Height="32"
                                            MinWidth="180"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center">
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="WorkloadFilterFlyout" Placement="Bottom">
                                        <StackPanel Width="300" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="SelectAllWorkloads" Content="All"/>
                                                <Button x:Name="ClearAllWorkloads" Content="None"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="WorkloadFilterPanel" Spacing="2"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <StackPanel x:Name="ParticleFilterColumn" Spacing="4" VerticalAlignment="Bottom"
                                    MinWidth="150">
                            <TextBlock x:Name="ParticleFilterLabel" Text="Particles" Margin="1,0,0,0"/>
                            <DropDownButton x:Name="ParticleFilterButton" Content="All particle counts" Height="32"
                                            MinWidth="150"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center">
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="ParticleFilterFlyout" Placement="Bottom">
                                        <StackPanel Width="300" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="SelectAllParticles" Content="All"/>
                                                <Button x:Name="ClearAllParticles" Content="None"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="ParticleFilterPanel" Spacing="2"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <StackPanel x:Name="StepsFilterColumn" Spacing="4" VerticalAlignment="Bottom"
                                    MinWidth="120" Visibility="Collapsed">
                            <TextBlock x:Name="StepsFilterLabel" Text="Steps" Margin="1,0,0,0"/>
                            <DropDownButton x:Name="StepsFilterButton" Content="All step counts" Height="32"
                                            MinWidth="120"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center">
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="StepsFilterFlyout" Placement="Bottom">
                                        <StackPanel Width="260" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="SelectAllSteps" Content="All"/>
                                                <Button x:Name="ClearAllSteps" Content="None"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="StepsFilterPanel" Spacing="2"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <ComboBox x:Name="SortBox" Header="Sort by" Width="180" SelectedIndex="0" Visibility="Collapsed"
                                  VerticalAlignment="Bottom" SelectionChanged="OnHistoryViewChanged">
                            <ComboBoxItem x:Name="SortTime">Time (newest)</ComboBoxItem>
                            <ComboBoxItem x:Name="SortScore">Score (high→low)</ComboBoxItem>
                            <ComboBoxItem x:Name="SortApi">Graphics API</ComboBoxItem>
                            <ComboBoxItem x:Name="SortDevice">GPU / Renderer</ComboBoxItem>
                            <ComboBoxItem x:Name="SortWorkload">Workload</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="WorkloadFilterBox" Header="Workload" Width="170" SelectedIndex="0" Visibility="Collapsed"
                                  VerticalAlignment="Bottom" SelectionChanged="OnHistoryViewChanged">
                            <ComboBoxItem x:Name="WorkloadFilterAll" Tag="*">All workloads</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="ParticleFilterBox" Header="Particles" Width="190" SelectedIndex="0" Visibility="Collapsed"
                                  VerticalAlignment="Bottom" SelectionChanged="OnHistoryViewChanged">
                            <ComboBoxItem x:Name="ParticleFilterAll" Tag="0">All particle counts</ComboBoxItem>
                        </ComboBox>

                        <StackPanel x:Name="DeviceFilterColumn" Spacing="4" VerticalAlignment="Bottom"
                                    MinWidth="200">
                            <TextBlock x:Name="GpuFilterLabel" Text="GPUs" Margin="1,0,0,0"/>
                            <DropDownButton x:Name="GpuFilterButton" Content="All GPUs" Height="32"
                                            MinWidth="200"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center">
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="GpuFilterFlyout" Placement="Bottom">
                                        <StackPanel Width="300" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="SelectAllGpus" Content="All"/>
                                                <Button x:Name="ClearAllGpus" Content="None"/>
                                            </StackPanel>
                                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="GpuFilterPanel" Spacing="2"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <ComboBox x:Name="TimeRangeBox" Header="Time range" Width="150"
                                  SelectedIndex="0"
                                  VerticalAlignment="Bottom" SelectionChanged="OnHistoryViewChanged">
                            <ComboBoxItem x:Name="RangeAll">All</ComboBoxItem>
                            <ComboBoxItem x:Name="RangeToday">Today</ComboBoxItem>
                            <ComboBoxItem x:Name="Range7">Last 7 days</ComboBoxItem>
                            <ComboBoxItem x:Name="Range30">Last 30 days</ComboBoxItem>
                            <ComboBoxItem x:Name="RangeCustom">Custom range…</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Custom date range (only shown for "Custom range…") -->
                    <StackPanel x:Name="DateRangeRow" Grid.Row="3" Orientation="Horizontal" Spacing="16"
                                Margin="0,0,0,8" Visibility="Collapsed">
                        <CalendarDatePicker x:Name="FromDate" Header="From" MinWidth="200"
                                            DateChanged="OnDateRangeChanged"/>
                        <CalendarDatePicker x:Name="ToDate" Header="To" MinWidth="200"
                                            DateChanged="OnDateRangeChanged"/>
                    </StackPanel>

                    <Border Grid.Row="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <!-- Header + rows scroll horizontally together; the ListView keeps
                             its own vertical scroll. Columns auto-size to content. -->
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="HistoryHeader" Grid.Row="0" Visibility="Collapsed"/>
                                <StackPanel x:Name="HistoryHeaderPanel" Grid.Row="0" Orientation="Horizontal"
                                            Margin="60,6,16,2" Spacing="0" VerticalAlignment="Center"/>
                                <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="Multiple"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollMode="Disabled"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===================== Charts page ===================== -->
                <Grid x:Name="ChartsPage" Visibility="Collapsed" Margin="28,12,28,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <TextBlock x:Name="ChartsTitle" Text="Charts" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Button x:Name="GenChartsButton" Content="Generate Charts" Click="OnGenerateCharts" VerticalAlignment="Bottom"/>
                        <ProgressRing x:Name="ChartsBusy" IsActive="False" Width="22" Height="22" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="ChartsStatus" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="ChartsPanel" Spacing="12"/>
                    </ScrollViewer>
                </Grid>

                <!-- ===================== Settings page ===================== -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="28,12,28,28">
                    <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Border Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="16">
                                <ComboBox x:Name="ThemeBox" Header="Theme" SelectedIndex="0" Width="220"
                                          SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem x:Name="ThemeSystem" Content="Use system setting"/>
                                    <ComboBoxItem x:Name="ThemeLight" Content="Light"/>
                                    <ComboBoxItem x:Name="ThemeDark" Content="Dark"/>
                                </ComboBox>
                                <ComboBox x:Name="LangBox" Header="Language" SelectedIndex="0" Width="220"
                                          SelectionChanged="OnLangChanged">
                                    <ComboBoxItem x:Name="LangAuto" Content="Auto"/>
                                    <ComboBoxItem>English</ComboBoxItem>
                                    <ComboBoxItem>简体中文</ComboBoxItem>
                                    <ComboBoxItem>日本語</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== About page ===================== -->
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" Padding="28,12,28,28">
                    <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock x:Name="AboutTitle" Text="About" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Border Padding="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Image x:Name="AboutIcon" Width="56" Height="56" VerticalAlignment="Top"/>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Mangekyo" FontSize="20"
                                                   FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AboutVersion" Opacity="0.72"
                                                   Text="Version —" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="AboutDesc" Opacity="0.85" TextWrapping="Wrap"
                                           Text="Cross-API CPU &amp; GPU Benchmark Suite — native C++/WinRT frontend."/>
                                <HyperlinkButton Content="GitHub"
                                                 NavigateUri="https://github.com/Fairchild2333/Vulkan-GPU-Compute-Microbenchmark"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </NavigationView>
    </Grid>
</Window>
