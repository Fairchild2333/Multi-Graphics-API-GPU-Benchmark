// App icon for the GUI binary. 101 is the lowest-numbered icon, so Explorer /
// the taskbar pick it up; it's also loaded explicitly in MainWindow's ctor for
// the caption, title-bar logo and About card.
#include <winver.h>

#define IDI_APPICON 101
IDI_APPICON ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 0,2,6,0
 PRODUCTVERSION 0,2,6,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0C09 = English (Australia); 04B0 = Unicode code page.
        BLOCK "0C0904B0"
        BEGIN
            VALUE "CompanyName", "Fairchild\0"
            VALUE "FileDescription", "Mangekyo - Cross-API CPU & GPU Benchmark Suite\0"
            VALUE "FileVersion", "0.2.6\0"
            VALUE "InternalName", "Mangekyo\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Fairchild\0"
            VALUE "OriginalFilename", "gpu_bench_gui.exe\0"
            VALUE "ProductName", "Mangekyo\0"
            VALUE "ProductVersion", "0.2.6\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C09, 1200
    END
END
