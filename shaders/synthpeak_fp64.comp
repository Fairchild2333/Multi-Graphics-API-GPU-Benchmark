#version 450

// Synthetic peak FP64 (double) throughput. Same structure as the FP32 variant;
// requires the shaderFloat64 device feature. FLOPs = numThreads * iters * 8 * 2.

#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer OutBuf {
    double data[];
} outBuf;

layout(push_constant) uniform PeakParams {
    uint  iters;
    float mul;
    float add;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    double s = double(gid & 1023u) * 0.001LF + 0.5LF;
    double a0=s, a1=s+0.1LF, a2=s+0.2LF, a3=s+0.3LF,
           a4=s+0.4LF, a5=s+0.5LF, a6=s+0.6LF, a7=s+0.7LF;
    double m = double(p.mul), c = double(p.add);

    for (uint i = 0u; i < p.iters; ++i) {
        a0 = a0 * m + c; a1 = a1 * m + c; a2 = a2 * m + c; a3 = a3 * m + c;
        a4 = a4 * m + c; a5 = a5 * m + c; a6 = a6 * m + c; a7 = a7 * m + c;
    }

    outBuf.data[gid] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
}
