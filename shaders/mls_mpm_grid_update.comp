#version 450

// MLS-MPM pass 4/5: convert fixed-point nodal momentum to velocity, apply
// gravity and stationary collision constraints, then overwrite vx/vy/vz with
// fixed-point velocity. Mass remains intact for G2P and volume reconstruction.
//
// Dispatch ceil(gridX/8), ceil(gridY/8), ceil(gridZ/4). A compute barrier is
// required before G2P or grid-mass volume resolve reads the grid.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

struct GridCell {
    int vx;
    int vy;
    int vz;
    int mass;
};

layout(set = 0, binding = 1, std430) buffer GridBuffer {
    GridCell cells[];
} gridBuffer;

layout(push_constant) uniform MpmParams {
    uvec4 gridSizeAndCount;
    vec4  simulation;
    vec4  material;
    vec4  gridOriginDx;
    vec4  sphere;
    vec4  collision;
} p;

const float kFixedContributionLimit = 536870911.0;

float fixedScale() {
    return max(abs(p.material.z), 1.0);
}

float decodeFixed(int value) {
    return float(value) / fixedScale();
}

int encodeFixedSigned(float value) {
    float scaled = clamp(value * fixedScale(),
                         -kFixedContributionLimit,
                          kFixedContributionLimit);
    return int(round(scaled));
}

uint gridIndex(uvec3 c) {
    return c.x + p.gridSizeAndCount.x *
                 (c.y + p.gridSizeAndCount.y * c.z);
}

vec3 collideVelocity(vec3 velocity, vec3 outwardNormal) {
    float normalSpeed = dot(velocity, outwardNormal);
    if (normalSpeed >= 0.0)
        return velocity;

    float restitution = clamp(p.collision.x, 0.0, 1.0);
    float tangentialScale = 1.0 - clamp(p.collision.y, 0.0, 1.0);
    vec3 tangential = velocity - normalSpeed * outwardNormal;
    return tangential * tangentialScale -
           restitution * normalSpeed * outwardNormal;
}

void main() {
    uvec3 coord = gl_GlobalInvocationID.xyz;
    if (any(greaterThanEqual(coord, p.gridSizeAndCount.xyz)))
        return;

    uint index = gridIndex(coord);
    float mass = decodeFixed(gridBuffer.cells[index].mass);
    if (mass <= 0.0) {
        gridBuffer.cells[index].vx = 0;
        gridBuffer.cells[index].vy = 0;
        gridBuffer.cells[index].vz = 0;
        return;
    }

    vec3 velocity = vec3(decodeFixed(gridBuffer.cells[index].vx),
                         decodeFixed(gridBuffer.cells[index].vy),
                         decodeFixed(gridBuffer.cells[index].vz)) / mass;
    velocity.y += p.simulation.y * max(p.simulation.x, 0.0);

    // Stationary domain walls. boundaryCells should normally be >= 2 so each
    // particle keeps its complete 3x3x3 interpolation support inside the grid.
    float boundary = max(p.material.w, 0.0);
    vec3 maxCoord = vec3(p.gridSizeAndCount.xyz - uvec3(1u));
    if (float(coord.x) < boundary)
        velocity = collideVelocity(velocity, vec3(1.0, 0.0, 0.0));
    if (float(coord.x) > maxCoord.x - boundary)
        velocity = collideVelocity(velocity, vec3(-1.0, 0.0, 0.0));
    if (float(coord.y) < boundary)
        velocity = collideVelocity(velocity, vec3(0.0, 1.0, 0.0));
    if (float(coord.y) > maxCoord.y - boundary)
        velocity = collideVelocity(velocity, vec3(0.0, -1.0, 0.0));
    if (float(coord.z) < boundary)
        velocity = collideVelocity(velocity, vec3(0.0, 0.0, 1.0));
    if (float(coord.z) > maxCoord.z - boundary)
        velocity = collideVelocity(velocity, vec3(0.0, 0.0, -1.0));

    // Grid-level sphere constraint prevents inward velocity before G2P. G2P
    // also projects particle positions as a final tunnelling guard.
    float radius = p.sphere.w;
    if (radius > 0.0) {
        vec3 worldPosition = p.gridOriginDx.xyz +
                             vec3(coord) * max(abs(p.gridOriginDx.w), 1.0e-6);
        vec3 delta = worldPosition - p.sphere.xyz;
        float distanceToCentre = length(delta);
        if (distanceToCentre < radius + 0.5 * abs(p.gridOriginDx.w)) {
            vec3 normal = distanceToCentre > 1.0e-6
                ? delta / distanceToCentre
                : vec3(0.0, 1.0, 0.0);
            velocity = collideVelocity(velocity, normal);
        }
    }

    float maxVelocity = p.collision.w;
    float speed = length(velocity);
    if (maxVelocity > 0.0 && speed > maxVelocity)
        velocity *= maxVelocity / max(speed, 1.0e-6);

    gridBuffer.cells[index].vx = encodeFixedSigned(velocity.x);
    gridBuffer.cells[index].vy = encodeFixedSigned(velocity.y);
    gridBuffer.cells[index].vz = encodeFixedSigned(velocity.z);
}
