#version 430

// All-pairs gravitational N-body compute shader (OpenGL 4.3).
// Compute-bound counterpart to compute_gl.comp; see shaders/nbody.comp for notes.
// Reuses the same Particle SSBO (2 x vec4) — no extra buffers.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
};

layout(binding = 0, std430) buffer ParticleBuffer {
    Particle particles[];
} particleBuffer;

layout(binding = 1, std140) uniform NBodyParams {
    float deltaTime;
    float softening;
    uint  numBodies;
};

const uint TILE = 256u;
shared vec4 sharedPos[TILE];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;

    vec3  myPos = particleBuffer.particles[gid].position.xyz;
    vec3  acc   = vec3(0.0);
    float soft2 = softening * softening;

    uint tiles = numBodies / TILE;
    for (uint t = 0u; t < tiles; ++t) {
        sharedPos[lid] = particleBuffer.particles[t * TILE + lid].position;
        barrier();

        for (uint j = 0u; j < TILE; ++j) {
            vec3  d        = sharedPos[j].xyz - myPos;
            float distSq   = dot(d, d) + soft2;
            float invDist  = inversesqrt(distSq);
            float invDist3 = invDist * invDist * invDist;
            acc += d * invDist3;
        }
        barrier();
    }

    vec3 vel = particleBuffer.particles[gid].velocity.xyz + acc * deltaTime;
    vec3 pos = myPos + vel * deltaTime;
    particleBuffer.particles[gid].velocity.xyz = vel;
    particleBuffer.particles[gid].position.xyz = pos;
}
