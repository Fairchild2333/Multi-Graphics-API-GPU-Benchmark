#include "cinematic_liquid_v2_common.hlsli"

// ===== CSSurfaceResolve =====
// Cinematic Liquid v2 render-density reconstruction, pass 3/3.
// Decode the fixed-point particle splats into the filterable R32F volume used
// by the ray marcher.



// Five float4 members deliberately preserve the 80-byte v2 Particle ABI.








// Shared 64-byte ABI for all three surface-reconstruction passes.


uint volumeIndex(uint3 coord) {
    return coord.x + volumeSizeAndCount.x *
        (coord.y + volumeSizeAndCount.y * coord.z);
}

float decodedDensityAt(int3 coord) {
    if (any(coord < int3(0,0,0)) ||
        any(coord >= int3(volumeSizeAndCount.xyz)))
        return 0.0;
    return float(densityAtomicBuffer[
        volumeIndex(uint3(coord))]) / max(kernel.z, 1.0);
}

float binomialWeight5(int offset) {
    int a = abs(offset);
    return a == 0 ? 6.0 : (a == 1 ? 4.0 : 1.0);
}

[numthreads(8, 8, 4)]
void CSSurfaceResolve(uint3 DTid : SV_DispatchThreadID)
{

    uint3 coord = DTid.xyz;
    if (any(coord >= volumeSizeAndCount.xyz)) return;

    float fixedScale = kernel.z;
    float maxDensity = max(kernel.w, 0.0);
    float density = fixedScale > 0.0 ? decodedDensityAt(int3(coord)) : 0.0;

    // MLS-MPM preserves volume well, but its advected particle lattice is less
    // neighbour-regular than the reference SPH set. A reconstruction-only
    // separable five-tap binomial kernel ([1 4 6 4 1]^3) suppresses the
    // particle-cell dimples that become oil-slick contours after Fresnel
    // shading. It does not alter simulation particles; its cost is included in
    // the versioned integrated score. A small raw contribution retains thin
    // sheets and detached droplets.
    float gaussianDensity = 0.0;
    for (int z = -2; z <= 2; ++z) {
        float wz = binomialWeight5(z);
        for (int y = -2; y <= 2; ++y) {
            float wy = binomialWeight5(y);
            for (int x = -2; x <= 2; ++x) {
                float wx = binomialWeight5(x);
                gaussianDensity += wx * wy * wz *
                    decodedDensityAt(int3(coord) + int3(x, y, z));
            }
        }
    }
    gaussianDensity *= 1.0 / 4096.0;
    // Bulk water keeps the strong anti-dimple reconstruction, while isolated
    // low-support particles retain more of their raw Spiky² density. A fixed
    // 90% blur erased the very droplets and crown tips generated by impacts.
    float filterMix = 0.90 * smoothstep(0.07, 0.58, gaussianDensity);
    density = lerp(density, gaussianDensity, filterMix);
    densityVolume[int3(int3(coord))] = (float4(clamp(density, 0.0, maxDensity), 0.0, 0.0, 1.0)).x;

}

