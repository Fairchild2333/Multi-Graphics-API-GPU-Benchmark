#version 450

// Cinematic Liquid SPH slice, pass 6: symmetric pressure + near-pressure.
//
// Linear equation of state P = k(rho - rho0) with Newton's-third-law
// symmetric averaging, plus the always-repulsive near-pressure term.
// Ported from jeantimex/fluid pressure.wgsl (identical kernels/EOS).

layout(local_size_x = 256) in;

layout(set = 0, binding = 1, std430) buffer SphVelocityBuffer {
    vec4 velocities[];
} sphVelocities;
layout(set = 0, binding = 2, std430) readonly buffer SphPredictedBuffer {
    vec4 predicted[];
} sphPredicted;
layout(set = 0, binding = 3, std430) readonly buffer SphDensityBuffer {
    vec2 densities[];
} sphDensities;
layout(set = 0, binding = 5, std430) readonly buffer SphCellCountBuffer {
    uint counts[];
} sphCellCounts;
layout(set = 0, binding = 6, std430) readonly buffer SphCellStartBuffer {
    uint starts[];
} sphCellStarts;
layout(set = 0, binding = 8, std430) readonly buffer SphSortedIndexBuffer {
    uint sortedIndices[];
} sphSortedIndices;

layout(push_constant) uniform SphParams {
    uvec4 counts;
    vec4 sim;
    vec4 fluid;
    vec4 kernels;
    vec4 boundsMin;
    vec4 boundsMax;
    vec4 world;
    vec4 coupling;
} pc;

uint hashCell3D(int cellX, int cellY, int cellZ) {
    const uint blockSize = 50u;
    uvec3 ucell = uvec3(uint(cellX + int(blockSize / 2u)),
                        uint(cellY + int(blockSize / 2u)),
                        uint(cellZ + int(blockSize / 2u)));
    uvec3 localCell = ucell % blockSize;
    uvec3 blockId = ucell / blockSize;
    uint blockHash = blockId.x * 15823u + blockId.y * 9737333u +
                     blockId.z * 440817757u;
    return localCell.x + blockSize * (localCell.y + blockSize * localCell.z) +
           blockHash;
}

float derivativeSpikyPow2(float dst, float radius, float scale) {
    if (dst <= radius) {
        float v = radius - dst;
        return -v * scale;
    }
    return 0.0;
}

float derivativeSpikyPow3(float dst, float radius, float scale) {
    if (dst <= radius) {
        float v = radius - dst;
        return -v * v * scale;
    }
    return 0.0;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.counts.x) return;

    vec2 densityPair = sphDensities.densities[index];
    float density = densityPair.x;
    float nearDensity = densityPair.y;
    if (density <= 0.0) return;

    float pressure = (density - pc.fluid.x) * pc.fluid.y;
    float nearPressure = pc.fluid.z * nearDensity;

    vec3 position = sphPredicted.predicted[index].xyz;
    float radius = max(pc.sim.z, 1.0e-5);
    float radiusSq = radius * radius;
    int originX = int(floor(position.x / radius));
    int originY = int(floor(position.y / radius));
    int originZ = int(floor(position.z / radius));

    vec3 force = vec3(0.0);

    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                uint key = hashCell3D(originX + x, originY + y, originZ + z) %
                           max(pc.counts.y, 1u);
                uint start = sphCellStarts.starts[key];
                uint end = start + sphCellCounts.counts[key];
                for (uint slot = start; slot < end; ++slot) {
                    uint neighbor = sphSortedIndices.sortedIndices[slot];
                    if (neighbor == index) continue;
                    vec3 offset = sphPredicted.predicted[neighbor].xyz - position;
                    float dstSq = dot(offset, offset);
                    if (dstSq > radiusSq) continue;

                    float dst = sqrt(dstSq);
                    vec3 direction = dst > 0.0 ? offset / dst : vec3(0.0);
                    vec2 neighborPair = sphDensities.densities[neighbor];

                    float neighborPressure = (neighborPair.x - pc.fluid.x) * pc.fluid.y;
                    float neighborNearPressure = pc.fluid.z * neighborPair.y;
                    float sharedPressure = 0.5 * (pressure + neighborPressure);
                    float sharedNearPressure =
                        0.5 * (nearPressure + neighborNearPressure);

                    if (neighborPair.x > 0.0)
                        force += direction *
                                 (derivativeSpikyPow2(dst, radius, pc.kernels.z) *
                                  sharedPressure / neighborPair.x);
                    if (neighborPair.y > 0.0)
                        force += direction *
                                 (derivativeSpikyPow3(dst, radius, pc.kernels.w) *
                                  sharedNearPressure / neighborPair.y);
                }
            }
        }
    }

    vec3 acceleration = force / density;
    sphVelocities.velocities[index] = vec4(
        sphVelocities.velocities[index].xyz + acceleration * pc.sim.x, 0.0);
}
