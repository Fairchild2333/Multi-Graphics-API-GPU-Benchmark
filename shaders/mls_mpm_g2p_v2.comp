#version 450

// Cinematic Liquid v2 pass 5: APIC grid-to-particle transfer, advection and
// a particle-level compound-body tunnelling guard.  Any final velocity change
// made by that guard is returned to BodyImpulse, preserving two-way coupling.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const int BODY_DUCK = 0;
const int BODY_PLAY_BALL = 1;
const int BODY_ANCHORED_BOAT = 2;
const int BODY_SINK_BALL = 3;
const uint MAX_BODIES = 32u;
const float DAM_GATE_X = -0.66;
const float DAM_GATE_HALF_Z = 1.36;
const float DAM_GATE_TOP = 1.72;
// The scored choreography re-stages the complete particle block at 4 s, so
// the reference-style dam is released immediately instead of being allowed to
// slump vertically behind an invisible gate before its horizontal release.
const float DAM_GATE_RELEASE_TIME = 0.0;
const float kBodyContributionLimit = 16777215.0;

struct Particle { vec4 position; vec4 velocity; vec4 C0; vec4 C1; vec4 C2; };
struct GridCell { int vx; int vy; int vz; int mass; };
struct BodyState {
    vec4 positionType;
    vec4 orientation;
    vec4 linearVelocityInvMass;
    vec4 angularVelocityInvInertia;
    vec4 shape0;
    vec4 shape1;
    vec4 material;
    vec4 color;
};
struct BodyImpulse { ivec4 linear; ivec4 angular; };

layout(set = 0, binding = 0, std430) buffer ParticleBuffer {
    Particle particles[];
} particleBuffer;
layout(set = 0, binding = 1, std430) readonly buffer GridBuffer {
    GridCell cells[];
} gridBuffer;
layout(r32f, set = 0, binding = 2) uniform writeonly image3D densityVolume;
layout(set = 0, binding = 3, std430) readonly buffer BodyStateBuffer {
    BodyState bodies[];
} bodyStateBuffer;
layout(set = 0, binding = 4, std430) buffer BodyImpulseBuffer {
    BodyImpulse impulses[];
} bodyImpulseBuffer;

layout(push_constant) uniform LiquidV2Params {
    uvec4 gridSizeAndCount;
    vec4 simulation;
    vec4 material;
    vec4 gridOriginDx;
    vec4 collision;
    vec4 coupling;
    uvec4 scene;
    vec4 pool;
} pc;

float gridFixedScale() { return max(abs(pc.material.z), 1.0); }
float bodyFixedScale() { return max(abs(pc.coupling.x), 1.0); }
float decodeGrid(int v) { return float(v) / gridFixedScale(); }
int encodeBody(float v) {
    return int(round(clamp(v * bodyFixedScale(),
                           -kBodyContributionLimit,
                            kBodyContributionLimit)));
}
vec3 quadraticWeights(float x) {
    float a = 1.5 - x;
    float b = x - 1.0;
    float c = x - 0.5;
    return vec3(0.5 * a * a, 0.75 - b * b, 0.5 * c * c);
}
bool insideGrid(ivec3 n, ivec3 s) {
    return all(greaterThanEqual(n, ivec3(0))) && all(lessThan(n, s));
}
uint gridIndex(ivec3 n) {
    uvec3 c = uvec3(n);
    return c.x + pc.gridSizeAndCount.x *
                 (c.y + pc.gridSizeAndCount.y * c.z);
}

vec4 safeQuaternion(vec4 q) {
    float q2 = dot(q, q);
    return q2 > 1.0e-10 ? q * inversesqrt(q2) : vec4(0.0, 0.0, 0.0, 1.0);
}
vec3 rotateByQuaternion(vec4 q, vec3 v) {
    q = safeQuaternion(q);
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}
vec3 inverseRotateByQuaternion(vec4 q, vec3 v) {
    q = safeQuaternion(q);
    q.xyz = -q.xyz;
    return rotateByQuaternion(q, v);
}
float sdSphere(vec3 p, float r) { return length(p) - max(r, 1.0e-4); }
float sdEllipsoid(vec3 p, vec3 r) {
    r = max(abs(r), vec3(1.0e-4));
    float k0 = length(p / r);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 1.0e-5);
}
float sdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1.0e-8), 0.0, 1.0);
    return length(pa - ba * h) - max(r, 1.0e-4);
}
float smoothUnion(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / max(k, 1.0e-5), 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}
// Keep identical to mls_mpm_grid_update_v2.comp (and the render frag): one
// plump belly, upswept tail, round head and flat beak, smooth-min blended.
float duckSdf(vec3 p, vec4 shape0, vec4 shape1) {
    vec3 bodyRadius = max(abs(shape0.xyz), vec3(0.02));
    float headRadius = max(shape1.x, 0.02);
    vec3 headCenter = vec3(shape1.y, shape1.z, 0.0);
    float beakLength = max(shape1.w, 0.02);

    float belly = sdEllipsoid(
        p - vec3(0.0, -0.04 * bodyRadius.y, 0.0),
        vec3(bodyRadius.x, 0.84 * bodyRadius.y, bodyRadius.z));
    float tail = sdEllipsoid(
        p - vec3(-0.72 * bodyRadius.x, 0.28 * bodyRadius.y, 0.0),
        bodyRadius * vec3(0.44, 0.30, 0.42));
    float duck = smoothUnion(belly, tail, 0.30 * bodyRadius.y);
    duck = smoothUnion(duck, sdSphere(p - headCenter, headRadius),
                       0.45 * headRadius);
    vec3 beakCenter = headCenter +
        vec3(headRadius + 0.30 * beakLength, -0.20 * headRadius, 0.0);
    float beak = sdEllipsoid(
        p - beakCenter,
        vec3(0.60 * beakLength, 0.24 * headRadius, 0.46 * headRadius));
    return smoothUnion(duck, beak, 0.12 * headRadius);
}
float bodyBoundingRadius(BodyState body) {
    int type = int(round(body.positionType.w));
    if (type == BODY_PLAY_BALL || type == BODY_SINK_BALL)
        return max(body.shape0.x, 0.01);
    if (type == BODY_DUCK) {
        vec3 bodyRadius = max(abs(body.shape0.xyz), vec3(0.02));
        float headReach = length(vec2(body.shape1.y, body.shape1.z)) +
                          max(body.shape1.x, 0.02) + max(body.shape1.w, 0.02);
        return max(length(bodyRadius), headReach);
    }
    if (type == BODY_ANCHORED_BOAT) {
        vec3 h = max(abs(body.shape0.xyz), vec3(0.02));
        float aftReach = length(vec2(max(body.shape1.y, h.x), 1.15 * h.y)) +
                         0.25 * max(body.shape1.x, 0.02);
        return max(length(h), aftReach);
    }
    return 0.01;
}
float bodySdf(BodyState body, vec3 worldPoint) {
    vec3 p = inverseRotateByQuaternion(
        body.orientation, worldPoint - body.positionType.xyz);
    int type = int(round(body.positionType.w));
    if (type == BODY_PLAY_BALL || type == BODY_SINK_BALL)
        return sdSphere(p, body.shape0.x);
    if (type == BODY_DUCK)
        return duckSdf(p, body.shape0, body.shape1);
    if (type == BODY_ANCHORED_BOAT) {
        vec3 h = max(abs(body.shape0.xyz), vec3(0.02));
        float propRadius = max(body.shape1.x, 0.02);
        float aft = max(body.shape1.y, h.x);
        vec3 a = vec3(-0.62 * h.x, -1.15 * h.y, 0.0);
        vec3 b = vec3(-aft, -1.15 * h.y, 0.0);
        return min(sdEllipsoid(p + vec3(0.0, 0.28 * h.y, 0.0), h),
               min(sdCapsule(p, a, b, 0.12 * propRadius),
                   sdSphere(p - b, 0.22 * propRadius)));
    }
    return 1.0e6;
}
vec3 bodyNormal(BodyState body, vec3 p, float e) {
    vec3 d = vec3(max(e, 1.0e-4), 0.0, 0.0);
    vec3 g = vec3(
        bodySdf(body, p + d.xyy) - bodySdf(body, p - d.xyy),
        bodySdf(body, p + d.yxy) - bodySdf(body, p - d.yxy),
        bodySdf(body, p + d.yyx) - bodySdf(body, p - d.yyx));
    return dot(g, g) > 1.0e-12 ? normalize(g) : vec3(0.0, 1.0, 0.0);
}

vec3 collideVelocity(vec3 velocity, vec3 surfaceVelocity, vec3 normal,
                     float restitution, float friction) {
    vec3 relative = velocity - surfaceVelocity;
    float normalSpeed = dot(relative, normal);
    if (normalSpeed >= 0.0) return velocity;
    vec3 tangential = relative - normalSpeed * normal;
    relative = tangential * (1.0 - clamp(friction, 0.0, 1.0)) -
               clamp(restitution, 0.0, 1.0) * normalSpeed * normal;
    return surfaceVelocity + relative;
}

void addBodyImpulse(uint index, vec3 impulse, vec3 torque) {
    atomicAdd(bodyImpulseBuffer.impulses[index].linear.x, encodeBody(impulse.x));
    atomicAdd(bodyImpulseBuffer.impulses[index].linear.y, encodeBody(impulse.y));
    atomicAdd(bodyImpulseBuffer.impulses[index].linear.z, encodeBody(impulse.z));
    atomicAdd(bodyImpulseBuffer.impulses[index].angular.x, encodeBody(torque.x));
    atomicAdd(bodyImpulseBuffer.impulses[index].angular.y, encodeBody(torque.y));
    atomicAdd(bodyImpulseBuffer.impulses[index].angular.z, encodeBody(torque.z));
    atomicAdd(bodyImpulseBuffer.impulses[index].angular.w, 1);
}

float roundedRectangleDistance(vec2 p, vec2 halfExtent, float radius) {
    radius = clamp(radius, 0.0, min(halfExtent.x, halfExtent.y));
    vec2 q = abs(p) - halfExtent + vec2(radius);
    return length(max(q, vec2(0.0))) +
           min(max(q.x, q.y), 0.0) - radius;
}

vec2 roundedRectangleNormal(vec2 p, vec2 halfExtent,
                            float radius, float epsilon) {
    vec2 ex = vec2(max(epsilon, 1.0e-4), 0.0);
    vec2 gradient = vec2(
        roundedRectangleDistance(p + ex, halfExtent, radius) -
        roundedRectangleDistance(p - ex, halfExtent, radius),
        roundedRectangleDistance(p + ex.yx, halfExtent, radius) -
        roundedRectangleDistance(p - ex.yx, halfExtent, radius));
    float g2 = dot(gradient, gradient);
    return g2 > 1.0e-12 ? gradient * inversesqrt(g2) : vec2(1.0, 0.0);
}

void constrainSimulationDomain(float radius, inout vec3 position,
                               inout vec3 velocity) {
    float dx = max(abs(pc.gridOriginDx.w), 1.0e-6);
    float margin = max(pc.material.w, 1.5) * dx + radius;
    vec3 domainMin = pc.gridOriginDx.xyz + vec3(margin);
    vec3 domainMax = pc.gridOriginDx.xyz +
        vec3(pc.gridSizeAndCount.xyz - uvec3(1u)) * dx - vec3(margin);
    domainMin.y = max(domainMin.y, pc.pool.z + radius);

    if (position.x < domainMin.x) {
        position.x = domainMin.x;
        velocity = collideVelocity(velocity, vec3(0.0), vec3(1,0,0),
                                   pc.collision.x, pc.collision.y);
    } else if (position.x > domainMax.x) {
        position.x = domainMax.x;
        velocity = collideVelocity(velocity, vec3(0.0), vec3(-1,0,0),
                                   pc.collision.x, pc.collision.y);
    }
    if (position.y < domainMin.y) {
        position.y = domainMin.y;
        velocity = collideVelocity(velocity, vec3(0.0), vec3(0,1,0),
                                   pc.collision.x, pc.collision.y);
    } else if (position.y > domainMax.y) {
        position.y = domainMax.y;
        velocity = collideVelocity(velocity, vec3(0.0), vec3(0,-1,0),
                                   pc.collision.x, pc.collision.y);
    }
    if (position.z < domainMin.z) {
        position.z = domainMin.z;
        velocity = collideVelocity(velocity, vec3(0.0), vec3(0,0,1),
                                   pc.collision.x, pc.collision.y);
    } else if (position.z > domainMax.z) {
        position.z = domainMax.z;
        velocity = collideVelocity(velocity, vec3(0.0), vec3(0,0,-1),
                                   pc.collision.x, pc.collision.y);
    }

}

void constrainFinitePoolWall(float particleRadius, vec3 previousPosition,
                             inout vec3 position, inout vec3 velocity) {
    float dx = max(abs(pc.gridOriginDx.w), 1.0e-6);
    vec3 rawMin = pc.gridOriginDx.xyz;
    vec3 rawMax = pc.gridOriginDx.xyz +
        vec3(pc.gridSizeAndCount.xyz - uvec3(1u)) * dx;
    float wallTop = mix(rawMin.y, rawMax.y, 0.42);

    // Once a particle has cleared the rim, let it fall on whichever side it
    // reached. This is the real overflow path; the outer simulation boundary
    // remains as a safety catch band.
    if (position.y > wallTop + particleRadius ||
        (previousPosition.y > wallTop + particleRadius &&
         position.y <= wallTop + particleRadius)) return;

    vec2 centre = 0.5 * (rawMin.xz + rawMax.xz);
    vec2 halfExtent = max(0.5 * (rawMax.xz - rawMin.xz) -
                          vec2(max(pc.pool.y, 0.0)), vec2(2.0 * dx));
    float cornerRadius = clamp(pc.pool.x, 0.0,
        max(min(halfExtent.x, halfExtent.y) - dx, 0.0));
    float previousDistance = roundedRectangleDistance(
        previousPosition.xz - centre, halfExtent, cornerRadius);
    float nextDistance = roundedRectangleDistance(
        position.xz - centre, halfExtent, cornerRadius);

    vec2 outward2 = roundedRectangleNormal(position.xz - centre, halfExtent,
                                            cornerRadius, 0.20 * dx);
    vec3 outward = vec3(outward2.x, 0.0, outward2.y);
    if (previousDistance <= 0.0 && nextDistance > -particleRadius) {
        position.xz -= outward2 * (nextDistance + particleRadius);
        velocity = collideVelocity(velocity, vec3(0.0), -outward,
                                   pc.collision.x, pc.collision.y);
    } else if (previousDistance > 0.0 && nextDistance < particleRadius) {
        position.xz += outward2 * (particleRadius - nextDistance);
        velocity = collideVelocity(velocity, vec3(0.0), outward,
                                   pc.collision.x, pc.collision.y);
    }
}

void constrainDamGate(float radius, vec3 previousPosition,
                      inout vec3 position, inout vec3 velocity) {
    if (pc.pool.w >= DAM_GATE_RELEASE_TIME ||
        abs(position.z) > DAM_GATE_HALF_Z + radius ||
        position.y > DAM_GATE_TOP + radius) return;

    if (previousPosition.x <= DAM_GATE_X &&
        position.x + radius > DAM_GATE_X) {
        position.x = DAM_GATE_X - radius;
        velocity = collideVelocity(velocity, vec3(0.0),
                                   vec3(-1.0, 0.0, 0.0),
                                   pc.collision.x, pc.collision.y);
    } else if (previousPosition.x > DAM_GATE_X &&
               position.x - radius < DAM_GATE_X) {
        position.x = DAM_GATE_X + radius;
        velocity = collideVelocity(velocity, vec3(0.0),
                                   vec3(1.0, 0.0, 0.0),
                                   pc.collision.x, pc.collision.y);
    }
}

void main() {
    uint particleIndex = gl_GlobalInvocationID.x;
    if (particleIndex >= pc.gridSizeAndCount.w ||
        any(lessThan(pc.gridSizeAndCount.xyz, uvec3(3u)))) return;

    float dx = max(abs(pc.gridOriginDx.w), 1.0e-6);
    float dt = max(pc.simulation.x, 0.0);
    Particle particle = particleBuffer.particles[particleIndex];
    vec3 gridPosition = (particle.position.xyz - pc.gridOriginDx.xyz) / dx;
    ivec3 base = ivec3(floor(gridPosition - vec3(0.5)));
    vec3 fractional = gridPosition - vec3(base);
    vec3 wx = quadraticWeights(fractional.x);
    vec3 wy = quadraticWeights(fractional.y);
    vec3 wz = quadraticWeights(fractional.z);
    ivec3 gridSize = ivec3(pc.gridSizeAndCount.xyz);

    vec3 newVelocity = vec3(0.0);
    mat3 newC = mat3(0.0);
    float validWeight = 0.0;
    float affineScale = 4.0 / (dx * dx);

    for (int z = 0; z < 3; ++z) {
        for (int y = 0; y < 3; ++y) {
            for (int x = 0; x < 3; ++x) {
                ivec3 offset = ivec3(x, y, z);
                ivec3 node = base + offset;
                if (!insideGrid(node, gridSize)) continue;
                uint index = gridIndex(node);
                if (gridBuffer.cells[index].mass <= 0) continue;
                float weight = wx[x] * wy[y] * wz[z];
                vec3 gridVelocity = vec3(
                    decodeGrid(gridBuffer.cells[index].vx),
                    decodeGrid(gridBuffer.cells[index].vy),
                    decodeGrid(gridBuffer.cells[index].vz));
                vec3 dpos = (vec3(offset) - fractional) * dx;
                newVelocity += weight * gridVelocity;
                newC += affineScale * weight * outerProduct(gridVelocity, dpos);
                validWeight += weight;
            }
        }
    }

    if (validWeight > 1.0e-6) {
        newVelocity /= validWeight;
        newC /= validWeight;
    } else {
        newVelocity = vec3(0.0);
        newC = mat3(0.0);
    }

    vec3 newPosition = particle.position.xyz + dt * newVelocity;
    float particleRadius = 0.42 * dx;
    uint bodyCount = min(pc.scene.x, MAX_BODIES);
    float particleMass = max(pc.material.y, 0.0);

    for (uint bodyIndex = 0u; bodyIndex < bodyCount; ++bodyIndex) {
        BodyState body = bodyStateBuffer.bodies[bodyIndex];
        // Conservative sphere cull mirroring mls_mpm_grid_update_v2.comp so
        // the seven-body loop stays cheap for the vast majority of particles.
        vec3 toBody = newPosition - body.positionType.xyz;
        float cullRadius = bodyBoundingRadius(body) + particleRadius + dx;
        if (dot(toBody, toBody) > cullRadius * cullRadius) continue;
        float distance = bodySdf(body, newPosition);
        if (distance >= particleRadius) continue;
        vec3 normal = bodyNormal(body, newPosition, 0.20 * dx);
        newPosition += normal * (particleRadius - distance);
        vec3 arm = newPosition - body.positionType.xyz;
        vec3 surfaceVelocity = body.linearVelocityInvMass.xyz +
            cross(body.angularVelocityInvInertia.xyz, arm);
        vec3 before = newVelocity;
        newVelocity = collideVelocity(
            newVelocity, surfaceVelocity, normal,
            max(pc.collision.x, body.material.x),
            max(pc.collision.y, body.material.y) * max(pc.coupling.z, 0.0));
        vec3 bodyImpulse = -particleMass * (newVelocity - before);
        if (dot(bodyImpulse, bodyImpulse) > 1.0e-16)
            addBodyImpulse(bodyIndex, bodyImpulse, cross(arm, bodyImpulse));
    }

    constrainDamGate(particleRadius, particle.position.xyz,
                     newPosition, newVelocity);
    constrainFinitePoolWall(particleRadius, particle.position.xyz,
                            newPosition, newVelocity);
    constrainSimulationDomain(particleRadius, newPosition, newVelocity);
    float speed = length(newVelocity);
    if (pc.collision.w > 0.0 && speed > pc.collision.w)
        newVelocity *= pc.collision.w / max(speed, 1.0e-6);

    particleBuffer.particles[particleIndex].position.xyz = newPosition;
    particleBuffer.particles[particleIndex].velocity.xyz = newVelocity;
    particleBuffer.particles[particleIndex].C0 = vec4(newC[0], 0.0);
    particleBuffer.particles[particleIndex].C1 = vec4(newC[1], 0.0);
    particleBuffer.particles[particleIndex].C2 = vec4(newC[2], 0.0);
}
