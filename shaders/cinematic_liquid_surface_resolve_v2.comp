#version 450

// Cinematic Liquid v2 render-density reconstruction, pass 3/3.
// Decode the fixed-point particle splats into the filterable R32F volume used
// by the ray marcher.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

// Five vec4 members deliberately preserve the 80-byte v2 Particle ABI.
struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 C0;
    vec4 C1;
    vec4 C2;
};

layout(set = 0, binding = 0, std430) readonly buffer ParticleBuffer {
    Particle particles[];
} particleBuffer;

layout(set = 0, binding = 1, std430) readonly buffer SurfaceAtomicBuffer {
    uint densityFixed[];
} surfaceAtomicBuffer;

layout(r32f, set = 0, binding = 2) uniform writeonly image3D surfaceVolume;

// Shared 64-byte ABI for all three surface-reconstruction passes.
layout(push_constant) uniform SurfaceReconstructionParams {
    uvec4 volumeSizeAndCount; // xyz: volume size, w: particle count
    vec4 volumeMinVoxel;      // xyz: world-space minimum, w: voxel size
    vec4 kernel;              // x: h, y: mass/restDensity, z: fixedScale, w: maxDensity
    uvec4 contract;            // host-defined reconstruction contract/version
} pc;

uint volumeIndex(uvec3 coord) {
    return coord.x + pc.volumeSizeAndCount.x *
        (coord.y + pc.volumeSizeAndCount.y * coord.z);
}

float decodedDensityAt(ivec3 coord) {
    if (any(lessThan(coord, ivec3(0))) ||
        any(greaterThanEqual(coord, ivec3(pc.volumeSizeAndCount.xyz))))
        return 0.0;
    return float(surfaceAtomicBuffer.densityFixed[
        volumeIndex(uvec3(coord))]) / max(pc.kernel.z, 1.0);
}

float binomialWeight5(int offset) {
    int a = abs(offset);
    return a == 0 ? 6.0 : (a == 1 ? 4.0 : 1.0);
}

void main() {
    uvec3 coord = gl_GlobalInvocationID.xyz;
    if (any(greaterThanEqual(coord, pc.volumeSizeAndCount.xyz))) return;

    float fixedScale = pc.kernel.z;
    float maxDensity = max(pc.kernel.w, 0.0);
    float density = fixedScale > 0.0 ? decodedDensityAt(ivec3(coord)) : 0.0;

    // MLS-MPM preserves volume well, but its advected particle lattice is less
    // neighbour-regular than the reference SPH set. A reconstruction-only
    // separable five-tap binomial kernel ([1 4 6 4 1]^3) suppresses the
    // particle-cell dimples that become oil-slick contours after Fresnel
    // shading. It does not alter simulation particles; its cost is included in
    // the versioned integrated score. A small raw contribution retains thin
    // sheets and detached droplets.
    float gaussianDensity = 0.0;
    for (int z = -2; z <= 2; ++z) {
        float wz = binomialWeight5(z);
        for (int y = -2; y <= 2; ++y) {
            float wy = binomialWeight5(y);
            for (int x = -2; x <= 2; ++x) {
                float wx = binomialWeight5(x);
                gaussianDensity += wx * wy * wz *
                    decodedDensityAt(ivec3(coord) + ivec3(x, y, z));
            }
        }
    }
    gaussianDensity *= 1.0 / 4096.0;
    // Bulk water keeps the strong anti-dimple reconstruction, while isolated
    // low-support particles retain more of their raw Spiky² density. A fixed
    // 90% blur erased the very droplets and crown tips generated by impacts.
    float filterMix = 0.90 * smoothstep(0.07, 0.58, gaussianDensity);
    density = mix(density, gaussianDensity, filterMix);
    imageStore(surfaceVolume, ivec3(coord),
               vec4(clamp(density, 0.0, maxDensity), 0.0, 0.0, 1.0));
}
