#version 430

// Fluid: gradient subtract (OpenGL 4.3). See shaders/fluid_subtract.comp.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer InBuf {
    vec4 inCells[];
};

layout(std430, binding = 1) buffer OutBuf {
    vec4 outCells[];
};

layout(std430, binding = 2) buffer InPressure {
    float inP[];
};

layout(binding = 5, std140) uniform FluidParams {
    float dt;
    float dx;
    uint  gridSize;
    float time;
} p;

uint cellIdx(uvec2 c) { return c.y * p.gridSize + c.x; }

void main() {
    uvec2 c = gl_GlobalInvocationID.xy;
    if (c.x >= p.gridSize || c.y >= p.gridSize) return;

    if (c.x == 0u || c.y == 0u || c.x == p.gridSize - 1u || c.y == p.gridSize - 1u) {
        vec4 edge = inCells[cellIdx(c)];
        edge.xy = vec2(0.0);
        outCells[cellIdx(c)] = edge;
        return;
    }

    float pL = inP[cellIdx(c - uvec2(1u, 0u))];
    float pR = inP[cellIdx(c + uvec2(1u, 0u))];
    float pD = inP[cellIdx(c - uvec2(0u, 1u))];
    float pU = inP[cellIdx(c + uvec2(0u, 1u))];

    vec2 gradP = 0.5 * vec2(pR - pL, pU - pD) / p.dx;

    vec4 src = inCells[cellIdx(c)];
    src.xy -= gradP;
    outCells[cellIdx(c)] = src;
}
