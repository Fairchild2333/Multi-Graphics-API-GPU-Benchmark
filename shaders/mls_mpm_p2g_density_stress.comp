#version 450

// MLS-MPM pass 3/5: estimate particle density from the mass grid, then add
// pressure and viscous stress impulses to the grid momentum accumulated by
// the first P2G pass. This is a liquid-oriented constitutive model: pressure
// is a linear equation of state with tensile pressure clamped to zero.
//
// Required ordering:
//   clear -> P2G mass/momentum -> barrier -> this pass -> barrier -> grid update

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 C0;
    vec4 C1;
    vec4 C2;
};

struct GridCell {
    int vx;
    int vy;
    int vz;
    int mass;
};

layout(set = 0, binding = 0, std430) readonly buffer ParticleBuffer {
    Particle particles[];
} particleBuffer;

layout(set = 0, binding = 1, std430) buffer GridBuffer {
    GridCell cells[];
} gridBuffer;

layout(push_constant) uniform MpmParams {
    uvec4 gridSizeAndCount;
    vec4  simulation;
    vec4  material;
    vec4  gridOriginDx;
    vec4  sphere;
    vec4  collision;
} p;

const float kFixedContributionLimit = 536870911.0;

float fixedScale() {
    return max(abs(p.material.z), 1.0);
}

float decodeFixed(int value) {
    return float(value) / fixedScale();
}

int encodeFixedSigned(float value) {
    float scaled = clamp(value * fixedScale(),
                         -kFixedContributionLimit,
                          kFixedContributionLimit);
    return int(round(scaled));
}

vec3 quadraticWeights(float x) {
    float a = 1.5 - x;
    float b = x - 1.0;
    float c = x - 0.5;
    return vec3(0.5 * a * a,
                0.75 - b * b,
                0.5 * c * c);
}

bool insideGrid(ivec3 node, ivec3 size) {
    return all(greaterThanEqual(node, ivec3(0))) &&
           all(lessThan(node, size));
}

uint gridIndex(ivec3 node) {
    uvec3 c = uvec3(node);
    return c.x + p.gridSizeAndCount.x *
                 (c.y + p.gridSizeAndCount.y * c.z);
}

void main() {
    uint particleIndex = gl_GlobalInvocationID.x;
    if (particleIndex >= p.gridSizeAndCount.w)
        return;
    if (any(lessThan(p.gridSizeAndCount.xyz, uvec3(3u))))
        return;

    float dt = max(p.simulation.x, 0.0);
    float restDensity = max(p.simulation.z, 1.0e-6);
    float stiffness = max(p.simulation.w, 0.0);
    float viscosity = max(p.material.x, 0.0);
    float particleMass = max(p.material.y, 0.0);
    float dx = max(abs(p.gridOriginDx.w), 1.0e-6);
    if (particleMass == 0.0 || dt == 0.0)
        return;

    Particle particle = particleBuffer.particles[particleIndex];
    vec3 gridPosition = (particle.position.xyz - p.gridOriginDx.xyz) / dx;
    ivec3 base = ivec3(floor(gridPosition - vec3(0.5)));
    vec3 fractional = gridPosition - vec3(base);
    vec3 wx = quadraticWeights(fractional.x);
    vec3 wy = quadraticWeights(fractional.y);
    vec3 wz = quadraticWeights(fractional.z);
    ivec3 gridSize = ivec3(p.gridSizeAndCount.xyz);

    // Interpolate nodal mass back to the particle and divide by cell volume.
    // Uniform particles with mass=rho*spacing^3 therefore recover rho.
    float interpolatedMass = 0.0;
    for (int z = 0; z < 3; ++z) {
        for (int y = 0; y < 3; ++y) {
            for (int x = 0; x < 3; ++x) {
                ivec3 node = base + ivec3(x, y, z);
                if (!insideGrid(node, gridSize))
                    continue;
                float weight = wx[x] * wy[y] * wz[z];
                interpolatedMass += weight *
                    max(decodeFixed(gridBuffer.cells[gridIndex(node)].mass), 0.0);
            }
        }
    }

    float cellVolume = dx * dx * dx;
    float density = interpolatedMass / max(cellVolume, 1.0e-12);
    float densityFloor = restDensity * max(p.collision.z, 1.0e-3);
    float particleVolume = particleMass / max(density, densityFloor);
    float compression = max(density / restDensity - 1.0, 0.0);
    float pressure = stiffness * compression;

    // C is the reconstructed affine velocity field (velocity gradient). For a
    // Newtonian fluid, sigma = -p I + mu (C + C^T).
    mat3 C = mat3(particle.C0.xyz, particle.C1.xyz, particle.C2.xyz);
    mat3 identity = mat3(1.0);
    mat3 stress = -pressure * identity + viscosity * (C + transpose(C));
    float stressFactor = -dt * particleVolume * 4.0 / (dx * dx);
    mat3 impulseMatrix = stressFactor * stress;

    for (int z = 0; z < 3; ++z) {
        for (int y = 0; y < 3; ++y) {
            for (int x = 0; x < 3; ++x) {
                ivec3 offset = ivec3(x, y, z);
                ivec3 node = base + offset;
                if (!insideGrid(node, gridSize))
                    continue;

                float weight = wx[x] * wy[y] * wz[z];
                if (weight <= 0.0)
                    continue;
                vec3 dpos = (vec3(offset) - fractional) * dx;
                vec3 impulse = weight * (impulseMatrix * dpos);
                uint index = gridIndex(node);
                atomicAdd(gridBuffer.cells[index].vx,
                          encodeFixedSigned(impulse.x));
                atomicAdd(gridBuffer.cells[index].vy,
                          encodeFixedSigned(impulse.y));
                atomicAdd(gridBuffer.cells[index].vz,
                          encodeFixedSigned(impulse.z));
            }
        }
    }
}
