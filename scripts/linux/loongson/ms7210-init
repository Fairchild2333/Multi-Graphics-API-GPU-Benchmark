#!/bin/sh
# Brings up the MS7210 DVO-to-HDMI bridge of the Loongson LS3A4000-7A1000-NUC-SE
# (HDMI on DVO output DPI-2) for pixel clocks above about 100 MHz, i.e. 1080p60.
# Mainline drm/loongson treats the DVO bridge as transparent; UnionTech OS's
# vendor driver initialises it at boot. These are that driver's writes,
# recorded with an I2C trace of a UOS boot: MS7210 at 0x59 on the display
# controller's second I2C bus, 16-bit register addresses (low byte first).
# Run after the display driver has set the mode (ms7210-init.service).
set -e
modprobe i2c-dev 2>/dev/null || true
BUS=""
for i in $(seq 1 60); do
    BUS=$(for d in /sys/bus/i2c/devices/i2c-*; do [ "$(cat "$d/name" 2>/dev/null)" = lsdc-i2c1 ] && basename "$d"; done | sed "s/i2c-//")
    [ -n "$BUS" ] && [ "$(cat /sys/class/drm/card*-DPI-2/enabled 2>/dev/null)" = enabled ] && break
    sleep 0.5
done
[ -n "$BUS" ] || { echo "ms7210-init: lsdc-i2c1 not found" >&2; exit 1; }
w() { i2ctransfer -y "$BUS" w3@0x59 "$1" "$2" "$3"; }
