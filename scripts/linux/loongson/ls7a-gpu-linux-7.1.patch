+/*
+ * When the GPU's DMA is cache coherent (the GC1000 in Loongson's LS7A1000),
+ * GPU writes can stay in the CPU caches, and a write-combined or uncached CPU
+ * mapping then reads stale memory. Map every buffer cached there.
+ */
+static bool coherent_cached = true;
+module_param(coherent_cached, bool, 0444);
+MODULE_PARM_DESC(coherent_cached, "Map buffers cached when GPU DMA is cache coherent");
+
+static bool etnaviv_cpu_cached(struct drm_device *dev)
+{
+	return coherent_cached && dev_is_dma_coherent(dev->dev);
+}
