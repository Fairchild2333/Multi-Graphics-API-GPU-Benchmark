+/*
+ * A buffer pinned in VRAM (every dumb buffer, so every scanout buffer) is
+ * shared as one contiguous range of VRAM. The GC1000 in the same bridge
+ * reaches VRAM at the address the display controller scans out from, so a
+ * frame it draws there goes to the screen without a copy. VRAM has no
+ * struct pages: the importer gets the DMA address alone and reaches the
+ * buffer from the CPU through dma_buf_mmap() and dma_buf_vmap().
+ */
+static struct sg_table *lsdc_gem_map_dma_buf(struct dma_buf_attachment *attach,
+					     enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = attach->dmabuf->priv;
+	struct lsdc_bo *lbo = gem_to_lsdc_bo(obj);
+	struct lsdc_device *ldev = to_lsdc(obj->dev);
+	struct sg_table *sgt;
+	dma_addr_t addr;
+	int ret;
+
+	if (lbo->tbo.resource->mem_type != TTM_PL_VRAM)
+		return drm_gem_map_dma_buf(attach, dir);
+
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret) {
+		kfree(sgt);
+		return ERR_PTR(ret);
+	}
+
+	addr = dma_map_resource(attach->dev, ldev->vram_base + lsdc_bo_gpu_offset(lbo),
+				obj->size, dir, DMA_ATTR_SKIP_CPU_SYNC);
+	if (dma_mapping_error(attach->dev, addr)) {
+		sg_free_table(sgt);
+		kfree(sgt);
+		return ERR_PTR(-EIO);
+	}
+
+	sg_set_page(sgt->sgl, NULL, obj->size, 0);
+	sg_dma_address(sgt->sgl) = addr;
+	sg_dma_len(sgt->sgl) = obj->size;
+
+	return sgt;
+}
+
+static void lsdc_gem_unmap_dma_buf(struct dma_buf_attachment *attach,
+				   struct sg_table *sgt,
+				   enum dma_data_direction dir)
+{
+	if (sg_page(sgt->sgl)) {
+		drm_gem_unmap_dma_buf(attach, sgt, dir);
+		return;
+	}
+
+	dma_unmap_resource(attach->dev, sg_dma_address(sgt->sgl), sg_dma_len(sgt->sgl),
+			   dir, DMA_ATTR_SKIP_CPU_SYNC);
+	sg_free_table(sgt);
+	kfree(sgt);
+}
+
+/* drm_gem_prime_dmabuf_ops, but for the mapping above */
+static const struct dma_buf_ops lsdc_dmabuf_ops = {
+	.attach = drm_gem_map_attach,
+	.detach = drm_gem_map_detach,
+	.map_dma_buf = lsdc_gem_map_dma_buf,
+	.unmap_dma_buf = lsdc_gem_unmap_dma_buf,
+	.release = drm_gem_dmabuf_release,
+	.mmap = drm_gem_dmabuf_mmap,
+	.vmap = drm_gem_dmabuf_vmap,
+	.vunmap = drm_gem_dmabuf_vunmap,
+};
+
+static struct dma_buf *lsdc_gem_prime_export(struct drm_gem_object *obj, int flags)
+{
+	struct dma_buf_export_info exp_info = {
+		.exp_name = KBUILD_MODNAME,
+		.owner = obj->dev->driver->fops->owner,
+		.ops = &lsdc_dmabuf_ops,
+		.size = obj->size,
+		.flags = flags,
+		.priv = obj,
+		.resv = obj->resv,
+	};
+
+	return drm_gem_dmabuf_export(obj->dev, &exp_info);
+}
+
+/* A buffer of this device comes back as itself, as drm_gem_prime_import() does. */
+struct drm_gem_object *lsdc_gem_prime_import(struct drm_device *ddev,
+					      struct dma_buf *dma_buf)
+{
+	struct drm_gem_object *obj = dma_buf->priv;
+
+	if (dma_buf->ops == &lsdc_dmabuf_ops && obj->dev == ddev) {
+		drm_gem_object_get(obj);
+		return obj;
+	}
+
+	return drm_gem_prime_import(ddev, dma_buf);
+}
+
 static void lsdc_gem_object_free(struct drm_gem_object *obj)
 {
 	struct ttm_buffer_object *tbo = to_ttm_bo(obj);
